# macOS
.DS_Store
**/.DS_Store

# Node / JavaScript
/node_modules/
bookbuild/node_modules/
/dist/
# Build outputs are ignored EXCEPT the two finished books. Gustav wants those
# in the repo as crash insurance - the machine can restart overnight and they
# take half an hour to rebuild. Note the /build/* form: with a bare /build/,
# git never descends into the directory and the exceptions below are ignored too.
/build/*
!/build/TheJavaScriptBlueprint.epub
!/build/TheJavaScriptBlueprint-print.pdf
npm-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.local
.env.*.local

# Python bytecode
__pycache__/
*.pyc
